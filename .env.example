# Portal v1 runtime configuration — copy to `.env` for local development.
# `.env` is gitignored. Never commit real values (Constitution IX).
# See specs/001-portal-v1/data-model.md §9.

# Shared household login name.
PORTAL_USERNAME=dev

# Argon2id password hash, PHC string form (m=19456,t=2,p=1).
# Generate locally — never store the plaintext. (Hashing helper arrives in WP2.)
PORTAL_PASSWORD_ARGON2=

# HMAC key for the session cookie — at least 32 bytes.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Absolute http(s) URL of the internal Docker socket-proxy (used from WP4 on).
DOCKER_PROXY_URL=http://socket-proxy.invalid/

# Optional: bare host used to build homemedia.port links (no scheme, no port).
# SERVICE_LINK_BASE=

# Absolute http(s) origin. Required for a production build; optional in dev.
# ORIGIN=https://localhost
